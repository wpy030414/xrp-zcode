# ============================================================================
# xrl-router-plugin-zcode 配置示例
# 复制为 .env 后填写。.env 永不进 git（已由 .gitignore 覆盖）。
# 变量表的权威说明见 docs/specs/module-config.md。
# ============================================================================

# ── 服务 ────────────────────────────────────────────────────────────────────
# 本插件监听端口（xrl-router 的 19068 / qwenwork 的 19066-19067 之外，互不冲突）
ZCODE_PORT=19065

# xrl-router 地址（插件通过 ws://<这里>/ws/plugin 注册）
XRL_ROUTER_URL=http://localhost:19068

# ── 凭证（必填）────────────────────────────────────────────────────────────
# 站点：bigmodel = 国内站（智谱 BigModel，默认）；zai = 国际站 Z.AI
# 国内站授权页是 bigmodel.cn，兑换走 bigmodel.cn/api/biz/*，推理走 open.bigmodel.cn
ZCODE_SITE=bigmodel

# 插件自持的 ZCode 凭证，逗号分隔可填多个（V24 起 xrl-router 不再管理插件密钥）。
# 请求时按顺序尝试：401/402/403/429 会顺延到下一把，成功的一把会被记住。
#   获取方式：pnpm run login
ZCODE_KEYS=

# ── 模型清单（可选，留空即自动发现）─────────────────────────────────────────
# 留空 → 启动时从上游 `GET /api/v1/client/configs` 的 builtinModels 自动发现，
#        拿不到才回退内置默认值（GLM-5.3,GLM-5.3-Flash）。
# 填了就完全以这里为准。支持 `上游模型ID=客户端别名` 语法：
#   GLM-5.3,GLM-5.3-Flash            两个模型，别名同上游名
#   GLM-5.3=glm-5.3,GLM-5.3-Flash    第一个模型用 glm-5.3 作别名
# 【上游模型名大小写敏感】，手填时务必写上游接受的形式。
ZCODE_MODELS=

# ── 上游端点 ────────────────────────────────────────────────────────────────
# Coding Plan（JWT）主端点，需要无痕验证头（两个站点共用）
ZCODE_BASE_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
# ── 国内站 BigModel（默认）──
# 主路线：pnpm run login 会把 OAuth 凭证兑换成免验证码 API Key，再打这里
BIGMODEL_ANTHROPIC_URL=https://open.bigmodel.cn/api/anthropic/v1/messages
# bigmodel.cn 基址（兑换链 /api/biz/* 使用）
BIGMODEL_API_BASE_URL=https://bigmodel.cn
# open.bigmodel.cn 基址（pnpm capture-key 的 API Key 探活使用）
BIGMODEL_OPEN_BASE_URL=https://open.bigmodel.cn
# ── 国际站 Z.AI（ZCODE_SITE=zai 时生效）──
ZAI_FALLBACK_URL=https://api.z.ai/api/anthropic/v1/messages
# api.z.ai 基址（国际站兑换链与探活使用）
ZAI_API_BASE=https://api.z.ai
# 额度 / 计费查询基址（供 pnpm capture-key 使用）
ZCODE_BILLING_BASE=https://zcode.z.ai/api/v1/zcode-plan

# ── 无痕验证（阿里云）───────────────────────────────────────────────────────
# 场景参数优先级：上游 configs 接口 > 环境变量（本组）> 内置默认值
# 注意：configs 接口实测【不能带任何查询参数】，带上会返回 parameter error
ZCODE_CAPTCHA_SCENE=11xygtvd
# 上游当前公布的 region 是 cn（社区旧文档里的 sgp 已过期）
ZCODE_CAPTCHA_REGION=cn
ZCODE_CAPTCHA_PREFIX=no8xfe
# 场景配置接口地址
ZCODE_CAPTCHA_CONFIG_URL=https://zcode.z.ai/api/v1/client/configs
# 设为 0 时完全不请求远端场景配置，只用上面三个变量
# ZCODE_CAPTCHA_REMOTE=0
# 单次求解超时（秒）
ZCODE_CAPTCHA_TIMEOUT=40
# 单次求解内部的失败重试次数
ZCODE_CAPTCHA_RETRIES=4
# 求得的 verifyParam 缓存时长（毫秒）
ZCODE_CAPTCHA_CACHE_TTL=45000
# 场景配置缓存时长（毫秒）；拉取失败时改用 60s 负缓存
ZCODE_CAPTCHA_CONFIG_CACHE_TTL=600000
# 求解器使用的 Node 可执行文件
ZCODE_NODE_PATH=node
# 求解器脚本路径（默认 <repo>/captcha/solver.cjs；e2e 用假脚本替换）
# ZCODE_SOLVER_PATH=

# ── 上游业务头（逆向所得，一般不需要改）─────────────────────────────────────
ZCODE_APP_VERSION=3.0.1
ZCODE_AGENT=glm
ZCODE_USER_AGENT=ZCode/3.0.1

# ── 插件 ↔ xrl-router 的节奏（一般不需要改）─────────────────────────────────
# 心跳间隔（毫秒）。router 侧 30s 检查、90s 超时；V24 心跳不携带 timestamp
ZCODE_HEARTBEAT_INTERVAL_MS=30000
# 断线重连退避（毫秒）：基数 × 2^n，封顶 max
ZCODE_RECONNECT_BASE_MS=1000
ZCODE_RECONNECT_MAX_MS=60000

# ── 仅 scripts/login.ts 读取 ────────────────────────────────────────────────
# OAuth 端点基址
ZCODE_OAUTH_BASE=https://zcode.z.ai/api/v1
